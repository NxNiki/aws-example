# Copy to .env for local dev. Never commit .env.

# Usage: source .env   (then run your ETL job in the same shell)
# Or: export $(grep -v '^#' .env | xargs) && python jobs/...

# ETL jobs auto-load `.env` (if present) when they import `bituslabs_ds.config` (local only).
# Usage: create `.env` in the repo root and run jobs (no need to `source .env`).

export REDSHIFT_USER=<your_redshift_username>
export REDSHIFT_PASSWORD=<your_redshift_password>
export BASTION_KEY_PATH=<your_bastion_key_path> # e.g. ~/.ssh/oceanhunter-prod-bastion-ec2.pem

# --- RAG service (Confluence retrieval) ---------------------------------
# Local dev: run `docker compose -f infra/docker-compose.opensearch.yml up -d`,
# then leave the values below as-is. For ECS, switch OPENSEARCH_AUTH=aws and
# point OPENSEARCH_HOST at the OpenSearch Serverless collection endpoint.
export OPENSEARCH_HOST=localhost
export OPENSEARCH_PORT=9200
export OPENSEARCH_SSL=true
export OPENSEARCH_AUTH=basic           # or 'aws' for SigV4 against OpenSearch Serverless / managed
export OPENSEARCH_USER=admin
export OPENSEARCH_PASSWORD=Admin@1234
export OPENSEARCH_INDEX=confluence_rag
# export OPENSEARCH_SERVICE=aoss       # only when OPENSEARCH_AUTH=aws

# Where the chat agent reaches the RAG service.
export RAG_SERVICE_URL=http://localhost:8052
export RAG_SERVICE_PORT=8052

# Embedding provider for the RAG indexer/retriever.
#   auto    → use OpenAI if OPENAI_API_KEY is set, else Gemini (default)
#   openai  → force OpenAI (text-embedding-3-small, 1536 dim by default)
#   gemini  → force Gemini (text-embedding-004,    768  dim by default)
# export RAG_EMBEDDING_PROVIDER=auto
# export RAG_EMBEDDING_MODEL=text-embedding-3-small   # provider-specific override
# export RAG_EMBEDDING_DIM=1536                       # only set when overriding model

# Other indexer overrides.
# export RAG_CHUNK_CHARS=1200
# export RAG_CHUNK_OVERLAP=200
# export RAG_SOURCES_PATH=src/rag_service/config/rag_sources.yaml

# At least one embedding API key is required. The chat agent already uses
# the same env vars, so they're typically already in your .env.
# export OPENAI_API_KEY=sk-...
# export GOOGLE_API_KEY=...

# Confluence credentials (already used by the chat agent).
# export CONFLUENCE_URL=https://yourcompany.atlassian.net
# export CONFLUENCE_EMAIL=you@bituslabs.com
# export CONFLUENCE_TOKEN=<atlassian_api_token>
