{
  "family": "etl-fish-hunter",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "etl",
      "image": "ECR_IMAGE_URI",
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/etl-fish-hunter",
          "awslogs-region": "us-west-2"
        }
      },
      "command": [
        "jobs/fish_hunter/etl_game_stats_daily_by_user.py",
        "--bastion-ip",
        "13.215.212.244"
      ],
      "secrets": [
        {
          "name": "BASTION_KEY_CONTENT",
          "valueFrom": "arn:aws:secretsmanager:us-west-2:ACCOUNT_ID:secret:etl/bastion-key"
        }
      ]
    }
  ]
}
