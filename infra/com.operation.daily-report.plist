<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.operation.daily-report</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /Users/niuxin/Documents/aws-example &amp;&amp; source .env 2>/dev/null || true &amp;&amp; .venv/bin/python jobs/operation_daily_report/run_daily_report.py --send-slack</string>
