# --- Stage 1: Builder ---
FROM public.ecr.aws/docker/library/python:3.11-slim AS builder

ENV POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=1 \
    POETRY_VIRTUALENVS_CREATE=1 \
    POETRY_CACHE_DIR=/tmp/poetry_cache

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://install.python-poetry.org | python3 -
ENV PATH="/root/.local/bin:$PATH"

COPY pyproject.toml poetry.lock ./

# Install main and dashboard (matplotlib, plotly, dash, polars)
RUN poetry install --only main,dashboard --no-root --no-cache && rm -rf $POETRY_CACHE_DIR

# --- Stage 2: Runtime ---
FROM public.ecr.aws/docker/library/python:3.11-slim AS runtime

ENV VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/src" \
    LOCAL_ROOT=/app

WORKDIR /app

# No heavy runtime deps needed for Dash (unlike ETL which needs libpq5)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/.venv /app/.venv

# Application code (matches repo layout: src/bituslabs_ds, src/dashboards)
COPY src/bituslabs_ds ./src/bituslabs_ds
COPY src/dashboards ./src/dashboards

# Run dashboard on 0.0.0.0 so it's reachable from outside the container
# Port 8050 is Dash's default
# Debug off in production Docker image
ENV DASHBOARD_CONFIG_DIR=/app/src/dashboards \
    DASHBOARD_DEBUG=false
EXPOSE 8050

# Use Gunicorn (production WSGI server) instead of Flask's single-threaded dev server.
#
# --workers 1          Single process so S3 data is only loaded once (memory-efficient).
# --worker-class gthread  Thread-based concurrency: multiple callbacks handled in parallel
#                      without duplicating in-memory data across processes.
# --threads 8          Up to 8 concurrent callback requests per container.
# --timeout 300        Allow up to 5 min for heavy callbacks (DataMetrics bootstrap CI).
#                      Flask's dev server has no timeout, making it easy to block forever.
# --keep-alive 65      Keep ALB connections alive slightly longer than ALB's 60 s idle
#                      timeout to avoid spurious 502/503s on long-idle connections.
# --access-logfile -   Emit access logs to stdout so CloudWatch captures them.
CMD ["gunicorn", \
     "--workers", "1", \
     "--worker-class", "gthread", \
     "--threads", "8", \
     "--timeout", "300", \
     "--keep-alive", "65", \
     "--bind", "0.0.0.0:8050", \
     "--access-logfile", "-", \
     "dashboards.game_stats_monitor:server"]
