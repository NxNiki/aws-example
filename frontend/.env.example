# Base URL for the dashboard_api. Leave empty for same-origin (prod, where
# dashboard_api serves the SPA). In dev, the Vite proxy handles /api, so this
# can stay empty too; set VITE_API_PROXY instead to point the proxy elsewhere.
VITE_API_BASE=

# Where the Vite dev proxy forwards /api (default http://localhost:8050).
VITE_API_PROXY=http://localhost:8050
