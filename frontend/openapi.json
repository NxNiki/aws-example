  "info": {
    "title": "dashboard_api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/data/config/{config_id}": {
      "get": {
        "description": "API endpoint: GET /api/data/config/{config_id} \u2014 resolved config for one game.\n\nDrives which tabs, metric groups, and date granularities the dashboard\nshows. This is also the snapshot the agent reads to decide which config to\nload and which tab to open for a natural-language data request.",
        "operationId": "get_config_api_data_config__config_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "config_id",
            "required": true,
            "schema": {
              "title": "Config Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Config",
        "tags": [
          "data"
        ]
      }
    },
    "/api/data/configs": {
      "get": {
        "description": "API endpoint: GET /api/data/configs \u2014 powers the game/config picker in the SPA top bar.\n\nReturns one entry per ``dashboard_config-*.yaml`` in ``DASHBOARD_CONFIG_DIR``;\nthe id is the filename minus the ``dashboard_config-`` prefix (e.g. ``ss01``,\n``fishhunter``).",
        "operationId": "list_configs_api_data_configs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Configs",
        "tags": [
          "data"
        ]
      }
