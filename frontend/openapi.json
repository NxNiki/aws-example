  "info": {
    "title": "dashboard_api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/data/config/{config_id}": {
      "get": {
        "description": "API endpoint: GET /api/data/config/{config_id} \u2014 resolved config for one game.\n\nDrives which tabs, metric groups, and date granularities the dashboard\nshows. This is also the snapshot the agent reads to decide which config to\nload and which tab to open for a natural-language data request.",
        "operationId": "get_config_api_data_config__config_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "config_id",
            "required": true,
            "schema": {
              "title": "Config Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Config",
        "tags": [
          "data"
        ]
      }
    },
    "/api/data/configs": {
      "get": {
        "description": "API endpoint: GET /api/data/configs \u2014 powers the game/config picker in the SPA top bar.\n\nReturns one entry per ``dashboard_config-*.yaml`` in ``DASHBOARD_CONFIG_DIR``;\nthe id is the filename minus the ``dashboard_config-`` prefix (e.g. ``ss01``,\n``fishhunter``).",
        "operationId": "list_configs_api_data_configs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Configs",
        "tags": [
          "data"
        ]
      }
    },
    "/api/data/series": {
      "post": {
        "description": "API endpoint: POST /api/data/series \u2014 metric time-series for a chart.\n\nReturns date-aligned series the frontend encodes into an ECharts chart.\nMetrics not present in the source parquet come back in ``missing`` rather\nthan failing the request, so the UI can flag them.",
        "operationId": "post_series_api_data_series_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeriesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeriesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Series",
        "tags": [
          "data"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "API endpoint: GET /api/health \u2014 ALB/uptime health check for the dashboard_api service.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    }
  }
}
